{
  "name": "vrije-academie-medusa",
  "version": "1.0.0",
  "description": "Medusa backend for Vrije Academie events e-commerce",
  "main": "index.js",
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build",
    "start": "medusa start",
    "migrate": "medusa db:migrate",
    "seed": "medusa seed -f ./data/seed.json",
    "seed:region": "medusa exec ./src/scripts/seed-region.ts",
    "seed:gift-card": "medusa exec ./src/scripts/seed-gift-card.ts",
    "salesforce:probe": "medusa exec ./src/scripts/sync-salesforce.ts -- --probe",
    "salesforce:parse-sample": "medusa exec ./src/scripts/sync-salesforce.ts -- --parse-sample",
    "salesforce:push": "medusa exec ./src/scripts/sync-salesforce.ts --",
    "salesforce:pull": "medusa exec ./src/scripts/sync-salesforce.ts --",
    "salesforce:import-future": "medusa exec ./src/scripts/import-future-productgroups.ts --",
    "salesforce:import-linked-vathuis": "medusa exec ./src/scripts/import-future-productgroups.ts -- --linked-vathuis",
    "salesforce:import-all": "medusa exec ./src/scripts/import-future-productgroups.ts -- --all",
    "salesforce:import-customers": "medusa exec ./src/scripts/import-salesforce-customers.ts --",
    "legacy:import-passwords": "medusa exec ./src/scripts/import-legacy-passwords.ts --",
    "salesforce:import-one": "medusa exec ./src/scripts/import-one-productgroup.ts --",
    "salesforce:backfill-facets": "medusa exec ./src/scripts/backfill-event-item-facets.ts --",
    "salesforce:audit-facets": "medusa exec ./src/scripts/audit-event-item-facets.ts",
    "salesforce:inspect": "medusa exec ./src/scripts/inspect-salesforce-productgroup.ts --",
    "salesforce:inspect-order": "medusa exec ./src/scripts/inspect-salesforce-order.ts --",
    "order:complete": "medusa exec ./src/scripts/complete-order.ts --",
    "search:reindex": "medusa exec ./src/scripts/reindex-search.ts",
    "tunnel": "node scripts/cloudflare-tunnel.mjs"
  },
  "keywords": [
    "medusa",
    "e-commerce",
    "events"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@medusajs/admin-sdk": "^2.13.6",
    "@medusajs/draft-order": "^2.13.6",
    "@medusajs/framework": "^2.13.6",
    "@medusajs/medusa": "^2.13.6",
    "@medusajs/ui": "^4.1.6",
    "@opensearch-project/opensearch": "^3.6.0",
    "@sanity/client": "^7.21.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@variablevic/mollie-payments-medusa": "^0.0.13",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "redis": "^5.11.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@medusajs/cli": "^2.13.6",
    "@types/node": "^25.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
