# Audience Player (VA Thuis video playback) — OAuth credentials from AP support
# AUDIENCE_PLAYER_CLIENT_ID=
# AUDIENCE_PLAYER_CLIENT_SECRET=
# AUDIENCE_PLAYER_PROJECT_ID=14
# AUDIENCE_PLAYER_API_URL=https://api.audienceplayer.com
# AUDIENCE_PLAYER_PUBLIC_EMBED_HOST=https://vrijeacademie.audienceplayer.com

DB_NAME=medusa

# OpenSearch (unified site + PLP search)
OPENSEARCH_NODE=http://localhost:9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
SEARCH_INDEX=va-search
# Secret for POST /hooks/sanity-search (Sanity publish webhook)
# SANITY_SEARCH_WEBHOOK_SECRET=

# Mollie payments — see docs/PAYMENT-MOLLIE.md
# MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MOLLIE_REDIRECT_URL=http://localhost:3000/bedankt
# Public URL for Mollie webhooks — use localhost for non-payment dev, or a tunnel URL (npm run tunnel)
# MEDUSA_URL=http://localhost:9000

# Stape / server GTM (purchase, refund, sign_up)
# SGTM_ENABLED=true
# SGTM_ENDPOINT_URL=https://your-container.stape.io/data
# Optional path appended to SGTM_ENDPOINT_URL (e.g. /v1/events)
# SGTM_EVENT_PATH=
# Bearer token, or pair with SGTM_API_KEY_HEADER for a custom header name
# SGTM_PURCHASE_SECRET=
# SGTM_API_KEY_HEADER=X-Api-Key
# SGTM_DEBUG=true
# SGTM_PREVIEW_HEADER=your-gtm-preview-token

# Transactional e-mail (OTP, cadeaubon). SMTP wins if both SMTP and SendGrid are set.
# Without either, OTP codes are logged to the server.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_IGNORE_TLS=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Vrije Academie" <info@vrijeacademie.nl>
# SENDGRID_API_KEY=
# SENDGRID_FROM="Vrije Academie" <info@vrijeacademie.nl>
# Public storefront origin for OTP email assets (logo PNG under /branding/logo-email.png)
# STOREFRONT_PUBLIC_URL=https://v2.vrijeacademie.nl

# Listing snapshots (PLP / Agenda / VA Thuis) — worker rebuilds, API serves from memory
# LISTING_CACHE_TTL_SEC=120
# LISTING_CACHE_HARD_TTL_SEC=604800
# LISTING_CACHE_REFRESH_INTERVAL_SEC=30
# LISTING_CACHE_LOG_HITS=true
# EVENT_DETAIL_FRESHNESS_TTL_SEC=120
# EVENT_DETAIL_CACHE_TTL_SEC=86400

# Salesforce webhook queue (lower on staging to reduce CPU spikes)
# SALESFORCE_WEBHOOK_QUEUE_BATCH_SIZE=10
# SALESFORCE_WEBHOOK_QUEUE_CONCURRENCY=2
# SALESFORCE_WEBHOOK_DEFER_LOADAVG=6
# SALESFORCE_WEBHOOK_DEFER_FREE_MB=512

# Slow /store request log threshold (ms)
# STORE_SLOW_REQUEST_MS=500

# host-performance-sampler.mjs (cron on server)
# PERF_PROBE_STOREFRONT_HOME=https://v2.vrijeacademie.nl/
# PERF_PROBE_STOREFRONT_PLP=https://v2.vrijeacademie.nl/ons-aanbod
# PERF_PROBE_MEDUSA_EVENTS=https://medusastag.vrijeacademie.nl/store/events?limit=24&sort=order
# PERF_PROBE_MEDUSA_PUBLISHABLE_KEY=

# Optional: bust Next.js hard cache for default /ons-aanbod when top-of-list products change
# STOREFRONT_REVALIDATE_PLP_URL=https://v2.vrijeacademie.nl/api/revalidate/plp
# STOREFRONT_REVALIDATE_SECRET=

# Salesforce — required to create Person Accounts (and thus push orders) for new website customers.
# Sandbox Participant record type: 0121t000000QIr0AAG (not Teacher).
# SALESFORCE_PERSON_ACCOUNT_RECORD_TYPE_ID=

# Medusa_* Salesforce fields (Medusa_Order_Id__c, Medusa_Product_Id__c, …). Off by default.
# Set true only after those External Id fields exist in the Salesforce org.
# SALESFORCE_MEDUSA_CUSTOM_FIELDS=false
# Origin used by `npm run salesforce:create-fields` (Medusa Admin, no path). Override with --admin-url.
# SALESFORCE_MEDUSA_ADMIN_URL=https://medusa.example.com

# Sentry (https://vrije-academie.sentry.io) — project: vrije-academie-medusa
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=
# SENTRY_PROFILES_SAMPLE_RATE=0
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=vrije-academie
# SENTRY_PROJECT=vrije-academie-medusa
