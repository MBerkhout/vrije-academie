# Audience Player (VA Thuis video playback) — OAuth credentials from AP support
# AUDIENCE_PLAYER_CLIENT_ID=
# AUDIENCE_PLAYER_CLIENT_SECRET=
# AUDIENCE_PLAYER_PROJECT_ID=14
# AUDIENCE_PLAYER_API_URL=https://api.audienceplayer.com
# AUDIENCE_PLAYER_PUBLIC_EMBED_HOST=https://vrijeacademie.audienceplayer.com

DB_NAME=medusa

# OpenSearch (unified site + PLP search)
OPENSEARCH_NODE=http://localhost:9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
SEARCH_INDEX=va-search
# Secret for POST /hooks/sanity-search (Sanity publish webhook)
# SANITY_SEARCH_WEBHOOK_SECRET=

# Mollie payments — see docs/PAYMENT-MOLLIE.md
# MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MOLLIE_REDIRECT_URL=http://localhost:3000/bedankt
# Public URL for Mollie webhooks — use localhost for non-payment dev, or a tunnel URL (npm run tunnel)
# MEDUSA_URL=http://localhost:9000

# Server-side GTM purchase (sGTM)
# SGTM_ENDPOINT_URL=https://your-sgtm.example/collect
# SGTM_PURCHASE_SECRET=

# OTP e-mail (optional — without this, codes are logged to the server)
# SENDGRID_API_KEY=
# SENDGRID_FROM=noreply@vrijeacademie.nl

# Optional: bust Next.js hard cache for default /ons-aanbod when top-of-list products change
# STOREFRONT_REVALIDATE_PLP_URL=https://v2.vrijeacademie.nl/api/revalidate/plp
# STOREFRONT_REVALIDATE_SECRET=
