SANITY_STUDIO_PROJECT_ID=your_sanity_project_id
SANITY_STUDIO_DATASET=production
# Optional custom subdomain for hosted Studio (defaults to SANITY_STUDIO_PROJECT_ID)
# SANITY_STUDIO_HOSTNAME=my-custom-name
SANITY_STUDIO_PREVIEW_URL=http://localhost:3001
# Medusa Admin base URL for "Open in Medusa" (required for the action; no code default)
SANITY_STUDIO_MEDUSA_ADMIN_URL=http://localhost:9000
