# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token for draft mode & visual editing (create at sanity.io/manage)
SANITY_API_READ_TOKEN=
# Include /studio when using hosted Studio (e.g. https://<project-id>.sanity.studio/studio)
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333/studio

# Medusa (required — no code default)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_API_KEY=

# Production/staging: same Redis as Medusa — shares unstable_cache across PM2 workers (prefix next:storefront:).
# Omit locally unless you run Redis; without it Next uses the default in-memory cache per process.
# REDIS_URL=redis://127.0.0.1:6379
# Per-deploy namespace for cache keys (deploy.sh sets from git SHA; optional locally)
# DEPLOYMENT_VERSION=
# Base URL for post-deploy listing warm (default http://127.0.0.1:3000)
# STOREFRONT_WARM_URL=

# Analytics (GTM + Cookiebot)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_COOKIE_BOT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NEXT_PUBLIC_GTM_ENABLED=false
# Canonical origin. https://v2.vrijeacademie.nl is noindexed automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HubSpot (for form-toolkit; create Private App at hubspot.com)
HUBSPOT_TOKEN=

# Optional: shared secret for Medusa → frontend PLP cache bust (POST /api/revalidate/plp)
REVALIDATE_SECRET=

# Sanity webhook → on-demand cache bust for published pages (POST /api/revalidate/sanity)
SANITY_REVALIDATE_SECRET=

# Sanity Studio → manual page cache bust (POST /api/revalidate/studio). Same value as Studio SANITY_STUDIO_REVALIDATE_SECRET. Do not reuse the webhook HMAC secret.
SANITY_STUDIO_REVALIDATE_SECRET=

# Sanity Studio → Medusa Admin deep-link (for the PLP page and Sanity Studio)
SANITY_STUDIO_MEDUSA_ADMIN_URL=http://localhost:9000
